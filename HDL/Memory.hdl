/**
 * The complete address space of the Hack computer's memory,
 * including RAM and memory-mapped I/O devices (Screen and Keyboard).
 *
 * Address Space Mapping:
 * - 0x0000 to 0x3FFF (0 to 16383): RAM16K (Data RAM)
 * - 0x4000 to 0x5FFF (16384 to 24575): Screen memory map (8K words)
 * - 0x6000 (24576): Keyboard memory map (1 word, read-only)
 *
 * Address Decoding:
 * - address[14] == 0       --> RAM16K
 * - address[14..13] == 10  --> Screen
 * - address[14..13] == 11  --> Keyboard
 */

CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // =========================================================================
    // 1. WRITE LOAD DECODING
    // =========================================================================
    // address[14] selects between RAM (0) and I/O devices (1)
    DMux(in=load, sel=address[14], a=loadRAM, b=loadIO);

    // If I/O selected, address[13] selects between Screen (0) and Keyboard (1)
    // Note: Keyboard register is read-only; write attempts to KBD are ignored.
    DMux(in=loadIO, sel=address[13], a=loadScreen, b=dummyKbd);

    // =========================================================================
    // 2. MEMORY CHIPS INTEGRATION
    // =========================================================================
    // RAM16K: 16K words addressed by 14 address bits address[0..13]
    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);

    // Screen: 8K words addressed by 13 address bits address[0..12]
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);

    // Keyboard: returns the ASCII code of currently pressed key (or 0)
    Keyboard(out=kbdOut);

    // =========================================================================
    // 3. READ OUTPUT MULTIPLEXING
    // =========================================================================
    // address[13..14] determines the output source:
    // sel = 00 -> ramOut (RAM lower 8K)
    // sel = 01 -> ramOut (RAM upper 8K)
    // sel = 10 -> screenOut (Screen)
    // sel = 11 -> kbdOut (Keyboard)
    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=kbdOut, sel=address[13..14], out=out);
}
